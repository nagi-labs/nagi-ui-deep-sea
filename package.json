{
  "name": "nagi-ui-deep-sea",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint src tests scripts vite.config.ts playwright.config.ts",
    "typecheck": "vue-tsc -b",
    "audit:owned": "node scripts/audit-owned-sources.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@nagi-labs/nagi-ui": "0.1.0",
    "@unovis/ts": "^1.6.7",
    "@unovis/vue": "^1.6.7",
    "motion-v": "^2.4.0",
    "vue": "^3.5.41",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plus": "^0.3.0",
    "vue-tsc": "^3.3.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "stackblitz": {
    "startCommand": "vp dev --host 0.0.0.0"
  }
}
